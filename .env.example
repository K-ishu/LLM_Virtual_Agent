# Use mock for local UI testing without external calls.
# Use openai for an OpenAI-compatible chat-completions API.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Leave empty for official OpenAI API.
# Example local value: http://localhost:11434/v1
OPENAI_BASE_URL=
